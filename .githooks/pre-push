#!/bin/sh
# ---------------------------------------------------------------------------
# CloudHelm pre-push 护栏
#
# 拦截两类高危操作，防止双账户协作模型被绕过：
#   1. 向 upstream（新账户主仓库 404-Wont-Fix/CloudHelm）推送
#      —— main 只接受 PR，不接受本地直推
#   2. 向任意远端直接推送 refs/heads/main
#      —— 包括老账户 fork 上的 main
#
# 应急绕过（谨慎使用）：
#   ALLOW_PROTECTED_PUSH=1 git push ...
#
# 启用方式：
#   sh scripts/install-hooks.sh          # Linux / macOS / Git Bash
#   pwsh -File scripts/install-hooks.ps1 # Windows PowerShell
# ---------------------------------------------------------------------------

set -u

REMOTE_NAME=${1:-}
REMOTE_URL=${2:-}
OVERRIDE=${ALLOW_PROTECTED_PUSH:-}

BLOCKED=0
REASON=''
SUGGEST=''

block() {
	# 保留第一条命中的原因，避免覆盖为更宽泛的提示
	if [ "$BLOCKED" -eq 1 ]; then
		return 0
	fi
	BLOCKED=1
	REASON=$1
	SUGGEST=$2
}

# --- 规则 1：upstream 只读 -------------------------------------------------
if [ "$REMOTE_NAME" = "upstream" ]; then
	block "禁止向 upstream（新账户主仓库）推送" \
		"main 只能通过 PR 合入；日常开发请推老账户：git push origin dev"
fi

case "$REMOTE_URL" in
*404-Wont-Fix/CloudHelm*)
	block "目标地址是主仓库 404-Wont-Fix/CloudHelm" \
		"日常开发请推老账户 fork：git push origin dev"
	;;
esac

# --- 规则 2：禁止直接推 main / master --------------------------------------
while read -r LOCAL_REF LOCAL_OID REMOTE_REF REMOTE_OID; do
	[ -z "${LOCAL_REF:-}" ] && continue
	case "$REMOTE_REF" in
	refs/heads/main | refs/heads/master)
		if [ "$LOCAL_OID" = "0000000000000000000000000000000000000000" ]; then
			block "禁止删除远端 $REMOTE_REF 分支" \
				"main 为受保护分支，不允许删除"
		else
			block "禁止直接推送 $REMOTE_REF" \
				"受保护分支只能通过 PR 合入；开发请使用 dev 分支"
		fi
		;;
	esac
done

if [ "$BLOCKED" -eq 0 ]; then
	exit 0
fi

if [ -n "$OVERRIDE" ]; then
	echo "" >&2
	echo "⚠  命中受保护推送规则，但 ALLOW_PROTECTED_PUSH 已设置 —— 放行。" >&2
	echo "   远端: $REMOTE_NAME ($REMOTE_URL)" >&2
	echo "   原因: $REASON" >&2
	echo "" >&2
	exit 0
fi

echo "" >&2
echo "✗ CloudHelm pre-push 护栏已拦截本次推送" >&2
echo "" >&2
echo "   远端 : $REMOTE_NAME ($REMOTE_URL)" >&2
echo "   原因 : $REASON" >&2
echo "   建议 : $SUGGEST" >&2
echo "   应急 : ALLOW_PROTECTED_PUSH=1 git push ..." >&2
echo "" >&2
echo "   完整协作规范见 WORKFLOW.md" >&2
echo "" >&2
exit 1
